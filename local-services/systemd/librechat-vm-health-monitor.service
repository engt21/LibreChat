[Unit]
Description=LibreChat in-VM application health monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/librechat-health-monitor/vm.env
ExecStart=%h/.local/libexec/librechat-health-monitor vm
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
