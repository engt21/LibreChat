<!--
  ClickHouse memory-limit override.
  2026-05-13: keep the ratio at 0.85 with stable mem_limit=3584m so
  Langfuse restart migrations have ~3.0 GiB of internal ClickHouse headroom
  without letting ClickHouse consume the whole host.
-->
<clickhouse>
    <max_server_memory_usage_to_ram_ratio>0.85</max_server_memory_usage_to_ram_ratio>
</clickhouse>
